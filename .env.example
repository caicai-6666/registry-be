# 本机开发连接已部署的 MySQL；容器中连接同一网络时改为 mysql:3306。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=registry
MYSQL_USER=registry
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_OPERATION_TIMEOUT_SECONDS=10

# SQLite 本地数据文件，相对于项目根目录或容器工作目录。
SQLITE_PATH=data/review-log/registry.db

# OpenAI 配置；使用模型服务前填写实际密钥。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 中间件平台接入；密钥须与 middleware-service 的平台白名单一致。
# 地址或密钥为空时不启用注册与心跳。
MIDDLEWARE_BASE_URL=http://127.0.0.1:22000
MIDDLEWARE_PLATFORM_CODE=registry
MIDDLEWARE_SECRET=
MIDDLEWARE_RETRY_INTERVAL_SECONDS=30
# 中间件登录建立消息客户端最长约 30 秒，预留请求超时余量。
MIDDLEWARE_REQUEST_TIMEOUT_SECONDS=40

# 平台目录：独立刷新平台列表及中间件会话存活状态，仅保存在内存。
PLATFORM_DIRECTORY_ENABLED=true
PLATFORM_DIRECTORY_REFRESH_INTERVAL_SECONDS=30
PLATFORM_DIRECTORY_RETRY_INTERVAL_SECONDS=5
PLATFORM_DIRECTORY_STALE_AFTER_SECONDS=90

# 中间件入库申请接收：拉取、下载和文件存储。
INGESTION_ENABLED=true
RESOURCE_ROOT=data/resource
REVIEW_LOG_ROOT=data/review-log
INGESTION_POLL_INTERVAL_SECONDS=2
INGESTION_RETRY_INTERVAL_SECONDS=5
INGESTION_DOWNLOAD_TIMEOUT_SECONDS=300
INGESTION_MAX_FILE_BYTES=67108864

# 删除申请接收：引用正式资源，不下载或另存审核附件。
DELETION_ENABLED=true
DELETION_POLL_INTERVAL_SECONDS=2
DELETION_RETRY_INTERVAL_SECONDS=5

# 入库工作流：相似文件召回。
INGESTION_DUPLICATE_TOP_K=5
INGESTION_DUPLICATE_MIN_SIMILARITY=0.8

# 入库工作流：并行重复性识别。
INGESTION_COMPARISON_CONCURRENCY=10

# 通行证推荐：复用 MyVector HNSW 跨平台搜索；0.8 为待校准的临时值。
PASSPORT_RECOMMENDATION_MIN_SIMILARITY=0.8
# HNSW 候选文件数量，范围 1 至 100；按阈值筛选后聚合通行证。
PASSPORT_RECOMMENDATION_TOP_K=100

# 本地 vLLM 嵌入模型。
VLLM_EMBEDDING_PROVIDER=vllm
VLLM_EMBEDDING_BASE_URL=https://u953156-u2th-6e19650f.weste.seetacloud.com:8443/v1
VLLM_EMBEDDING_API_KEY=
VLLM_EMBEDDING_MODEL=qwen3-vl-embedding-8b
VLLM_EMBEDDING_ENDPOINT=embeddings
VLLM_EMBEDDING_TIMEOUT_SECONDS=60
VLLM_EMBEDDING_BATCH_SIZE=32
VLLM_EMBEDDING_MAX_CONCURRENT_REQUESTS=10
VLLM_EMBEDDING_DIMENSIONS=4096
VLLM_EMBEDDING_NORMALIZE=true

# 本地 vLLM 多模态模型与 PDF 页面引用。
VLLM_MLLM_PROVIDER=vllm
VLLM_MLLM_BASE_URL=https://u953156-ae07-d6f63fdb.westd.seetacloud.com:8443/v1
VLLM_MLLM_API_KEY=
VLLM_MLLM_MODEL=qwen38-flash-next
VLLM_MLLM_ENDPOINT=chat_completions
VLLM_MLLM_TIMEOUT_SECONDS=300
VLLM_MLLM_MAX_CONCURRENT_REQUESTS=20
VLLM_MLLM_USE_MEDIA_REFERENCES=true
VLLM_MLLM_CONTEXT_WINDOW_TOKENS=262144
VLLM_MLLM_ENABLE_THINKING=false
VLLM_MLLM_REASONING_EFFORT=xhigh
VLLM_MLLM_TEMPERATURE=0.7
VLLM_MLLM_TOP_P=0.8
VLLM_MLLM_TOP_K=20
VLLM_MLLM_PRESENCE_PENALTY=1.5
VLLM_MLLM_REPETITION_PENALTY=1.0
VLLM_MLLM_SEED=3407
VLLM_MLLM_MAX_COMPLETION_TOKENS=8192
VLLM_MLLM_MAX_RENDER_SCALE=2.0
VLLM_MLLM_VISUAL_TOKEN_PATCH_SIZE=32
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_PAGE=2048
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_DOCUMENT=65536
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_REQUEST=131072
VLLM_MLLM_RESERVED_PROMPT_TOKENS=4096
VLLM_MLLM_RESERVED_RUNTIME_TOKENS=10240
VLLM_MLLM_MAX_PDF_PAGES=100
VLLM_MLLM_MAX_PAGE_PIXELS=4000000
VLLM_MLLM_MAX_PNG_BYTES=134217728
SQLITE_BUSY_TIMEOUT_SECONDS=5

# 用户在 knowledge-accumulation-be 登录，registry 仅向中间件查询用户 token。
# 中央身份和本地人员查询的总超时（秒）；中间件不可用时返回 503。
AUTH_REQUEST_TIMEOUT_SECONDS=5

# 文件判重 Agent（与消息接收及模型 HTTP 并发独立）。
FILE_DEDUPLICATION_MAX_VISIBLE_PAGES=3
FILE_DEDUPLICATION_MAX_ROUNDS=32
FILE_DEDUPLICATION_MAX_CONSECUTIVE_ERRORS=3
FILE_DEDUPLICATION_MAX_PAGE_READS=24
FILE_DEDUPLICATION_MAX_OBSERVATIONS=128

# 用户与平台管理员全表注册均由 knowledge-accumulation-be 负责，registry 不发布总表。

# 知识后端头像代理，填写含端口的服务根地址，例如 http://127.0.0.1:24000。
KNOWLEDGE_ACCUMULATION_BASE_URL=
KNOWLEDGE_ACCUMULATION_TIMEOUT_SECONDS=10
KNOWLEDGE_ACCUMULATION_AVATAR_MAX_BYTES=10485760

# 头像浏览器私有缓存时长，单位秒；0 表示不缓存。
KNOWLEDGE_ACCUMULATION_AVATAR_CACHE_SECONDS=86400

# 钉钉通讯录手动刷新：只更新已有员工的姓名和部门，不负责用户登录。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_TIMEOUT_SECONDS=10
DINGTALK_REFRESH_TIMEOUT_SECONDS=300
DINGTALK_REFRESH_MAX_CONCURRENCY=5
