# 默认不追踪，仅保留部署文件、项目文档和必要目录占位。
/**
!/.gitignore
!/.dockerignore
!/.env.example
!/Dockerfile
!/requirement.txt
!/README.md
!/AGENTS.md

# 应用源码与启动时读取的 SQLite 初始化定义。
!/app/
!/app/**/
!/app/**/*.py
!/app/infrastructure/sqlite_schema.sql

# 项目说明、接口、架构、能力与开发规范。
!/description/
!/description/**/
!/description/**/*.md

# 仅保留固定运行目录；平台子目录及真实文件由运行时创建。
!/data/
!/data/resource/
!/data/resource/.gitkeep
!/data/review-log/
!/data/review-log/tmp-file/
!/data/review-log/tmp-file/ingestion/
!/data/review-log/tmp-file/ingestion/.gitkeep
!/data/review-log/tmp-file/deletion/
!/data/review-log/tmp-file/deletion/.gitkeep

# 即使位于允许的源码、文档目录，也不追踪凭据、环境或缓存。
.env
.env.*
!/.env.example
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store
